{
  "shapes": "sev.prov-shapes@v0",
  "note": "Machine-readable endpoint shapes for the FULL sev@v0 target profile. Classes and predicate shapes live together, so a guard cannot carry a complete class registry beside an MVP-only predicate list. Endpoints name either a root KIND or an exact CLASS: collapsing Usage, Association and Attribution into one kind let qualifiedUsage point at an Association and hadPlan run from any Influence to any Entity. Language-neutral by design: a second implementation reads this file.",
  "kinds": [
    "activity",
    "entity",
    "agent",
    "influence",
    "any"
  ],
  "disjoint_pairs": [
    [
      "activity",
      "entity"
    ]
  ],
  "disjoint_note": "PROV-O declares exactly one disjointness axiom among the roots: prov:Activity owl:disjointWith prov:Entity. An Agent may also be an Entity (see PROV-O's normative wasAssociatedWith example, which types its agent as Person, Agent and Entity).",
