  "predicate_notes": {
    "shape_language": "Each endpoint is {\"kind\": <root kind>} or {\"class\": <exact class IRI>}. A class requirement is satisfied by that class or any declared subclass of it.",
    "wasInfluencedBy": "PROV-O leaves this unconstrained across the roots; modelled as any->any rather than guessed.",
    "qualified_relations": "PROV-O gives these exact ranges: qualifiedUsage->Usage, qualifiedAssociation->Association, qualifiedAttribution->Attribution, hadPlan Association->Plan, hadMember Collection->Entity."
  },
  "mvp_predicates": [
    "http://www.w3.org/ns/prov#used",
    "http://www.w3.org/ns/prov#generated",
    "http://www.w3.org/ns/prov#wasGeneratedBy",
    "http://www.w3.org/ns/prov#specializationOf"
  ],
  "mvp_note": "The subset the current projector can emit. The guard validates every predicate in `predicates` when it appears; this list exists so a reader can tell MVP coverage from target coverage without reading the projector."
